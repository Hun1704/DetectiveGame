    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: thu
    noiDung: "Bao Thanh Long... Ng\u01B0\u01A1i bi\u1EBFt ch\u1EEF ch\u1EE9"
    anhCamXuc: {fileID: -4988358978559244133, guid: cad25c014bd5b1542b02f3da026caf3b, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
