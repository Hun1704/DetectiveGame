  loiRaLinh: {fileID: 0}
  kichBanHoiThoai:
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "B\u1EA9m \u0110\u1EA1i Quan, con mu\u1ED1n t\u1ED1 c\xE1o quan huy\u1EC7n
      L\xFD H\xE0o, l\xE0 m\u1ED9t t\xEAn quan tham \xF4 l\u1EA1i! H\u1EAFn c\u1EA5u
      k\u1EBFt v\u1EDBi Ph\u1EE7 T\xE2m Hoa bu\xF4n ng\u01B0\u1EDDi v\xE0 nh\u1EADn
      h\u1ED1i l\u1ED9"
    anhCamXuc: {fileID: -6883753877697220212, guid: 6972d0607ba1e594db50f0d9d28cf38f, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 6
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: Thu
    noiDung: "Bao Thanh Long... Ng\u01B0\u01A1i bi\u1EBFt ch\u1EEF ch\u1EE9"
    anhCamXuc: {fileID: -4988358978559244133, guid: cad25c014bd5b1542b02f3da026caf3b, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "B\u1EA9m, con l\xE0 nho sinh, d\u0129 nhi\xEAn bi\u1EBFt ch\u1EEF"
    anhCamXuc: {fileID: -4988358978559244133, guid: cad25c014bd5b1542b02f3da026caf3b, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: Thu
    noiDung: "V\u1EADy ng\u01B0\u01A1i h\xE3y b\u01B0\u1EDBc l\xEAn \u0111\xE2y,
      nh\xECn cho k\u1EF9 xem trang n\xE0y vi\u1EBFt c\xE1i g\xEC"
    anhCamXuc: {fileID: 7321063716756074513, guid: 8f9ef7da4cc9fb44982029c9bf01e467, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "C\xE1i... c\xE1i g\xEC th\u1EBF n\xE0y? Kh\xF4ng! R\xF5 r\xE0ng l\xFAc
      \u1EDF Ph\u1EE7 T\xE2m Hoa \u0111\u01B0\u1EE3c ghi ch\xE9p L\xFD H\xE0o c\u1EA5t
      \u0111\u01B0\u1EE3c 5000 l\u01B0\u1EE3ng c\u01A1 m\xE0. Ch\xEDnh m\u1EAFt ta
      c\xF2n th\u1EA5y h\u1EAFn c\xF3 kho v\xE0ng"
    anhCamXuc: {fileID: 3827985875608978089, guid: 961261e15214196448eb5b8b2c0070b8, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: Thu
    noiDung: "\u0110\xE2y l\xE0 s\u1ED5 ghi n\u1EE3 c\u1EE7a s\xF2ng b\u1EA1c. Gi\u1EA5y
      tr\u1EAFng m\u1EF1c \u0111en, d\u1EA5u v\xE2n tay c\u1EE7a ng\u01B0\u01A1i
      c\xF2n \u0111\u1ECF ch\xF3t \u0111\xE2y. Ng\u01B0\u01A1i n\u1EE3 L\xFD H\xE0o
      500 l\u01B0\u1EE3ng, b\u1ECB h\u1EAFn si\u1EBFt n\u1EE3, n\xEAn ng\u01B0\u01A1i
      sinh h\u1EADn m\xE0 vu kh\u1ED1ng h\u1EAFn, \u0111\xFAng kh\xF4ng?"
    anhCamXuc: {fileID: -2752125890289259952, guid: d1fcb8c80a8af8e4ea45fdef0aa06d83, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "Kh\xF4ng! H\u1EAFn \u0111\xE3 th\xF4ng \u0111\u1ED3ng v\u1EDBi con
      \u1EA3 Ng\u1ECDc Khu\xEA \u0111\u1EC3 l\u1EEBa con"
    anhCamXuc: {fileID: 3827985875608978089, guid: 961261e15214196448eb5b8b2c0070b8, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
