    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: thu
    noiDung: "V\u1EADy ng\u01B0\u01A1i h\xE3y b\u01B0\u1EDBc l\xEAn \u0111\xE2y,
      nh\xECn cho k\u1EF9 xem trang n\xE0y vi\u1EBFt c\xE1i g\xEC"
    anhCamXuc: {fileID: 7321063716756074513, guid: 8f9ef7da4cc9fb44982029c9bf01e467, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
