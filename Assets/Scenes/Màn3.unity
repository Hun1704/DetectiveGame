    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "B\u1EA9m, con l\xE0 nho sinh, d\u0129 nhi\xEAn bi\u1EBFt ch\u1EEF"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
