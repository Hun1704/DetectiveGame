    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "C\xE1i... c\xE1i g\xEC th\u1EBF n\xE0y? Kh\xF4ng! R\xF5 r\xE0ng l\xFAc
      \u1EDF Ph\u1EE7 T\xE2m Hoa \u0111\u01B0\u1EE3c ghi ch\xE9p L\xFD H\xE0o c\u1EA5t
      \u0111\u01B0\u1EE3c 5000 l\u01B0\u1EE3ng c\u01A1 m\xE0. Ch\xEDnh m\u1EAFt ta
      c\xF2n th\u1EA5y h\u1EAFn c\xF3 kho v\xE0ng"
    anhCamXuc: {fileID: 3827985875608978089, guid: 961261e15214196448eb5b8b2c0070b8, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
