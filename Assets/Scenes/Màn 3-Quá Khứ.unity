  panelChiTiet: {fileID: 1603294389}
  nutXemChiTiet: {fileID: 1331708427}
  danhSachHoiThoai:
  - idNguoiNoi: 
    noiDung: "Cha n\u1EE3 n\u1EA7n nhi\u1EC1u qu\xE1 m\xE0... Cha \u0111\u1EE3i con,
