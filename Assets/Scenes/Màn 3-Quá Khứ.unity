    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: dan_chuyen
    noiDung: "L\xFD H\xE0o ki\u1EC3m tra g\u1EA7n ch\u1ED7 x\xE1c cha "
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: Quan
    noiDung: "Ch\u1EADc ch\u1EADc... \u0110\u01B0\u1EDDng \u0111\u01B0\u1EDDng l\xE0
      m\u1ED9t nh\xE0 nho, l\u1EA1i \u0111i vay n\u1EB7ng l\xE3i \u0111\u1EC3 r\u1ED3i
      t\xFAng qu\u1EABn l\xE0m li\u1EC1u. Ch\u1ED3ng gi\u1EBFt v\u1EE3, r\u1ED3i
      treo c\u1ED5 t\u1EF1 v\u1EABn. \u0110\xFAng l\xE0 bi k\u1ECBch."
    anhCamXuc: {fileID: 3103107032202501148, guid: 70c37cf473a44a54fa052463133eb927, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "\xD4ng n\xF3i b\u1EADy! Cha ta c\u1EA3 \u0111\u1EDDi thanh b\u1EA1ch,
      ch\u01B0a t\u1EEBng vay m\u01B0\u1EE3n ai n\u1EEDa xu. "
    anhCamXuc: {fileID: -5920170677128127979, guid: c7dd7826c7dd68247bd7aea3fa177303, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: Quan
    noiDung: "Th\u1EBF \u0111\xE2y l\xE0 g\xEC, ngay d\u01B0\u1EDBi ch\xE2n cha ng\u01B0\u01A1i
      l\xE0 t\u1EDD gi\u1EA5y n\u1EE3 c\u1EE7a h\u1EAFn \u0111\xE2y"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: dan_chuyen
    noiDung: "L\xFD H\xE0o n\xE9m t\u1EDD gi\u1EA5y n\u1EE3 xu\u1ED1ng \u0111\u1EA5t"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: Quan
    noiDung: "L\xE0 do x\xF4 x\xE1t! H\u1EAFn gi\u1EBFt v\u1EE3 trong c\u01A1n \u0111i\xEAn
      lo\u1EA1n. C\xF2n \u0111\xE2y... Gi\u1EA5y n\u1EE3 vi\u1EBFt tay c\u1EE7a cha
      ng\u01B0\u01A1i, m\u1EF1c c\xF2n ch\u01B0a kh\xF4 \u0111\xE2u. \u0110\u1EEBng
      c\xF3 gi\xE0 m\u1ED3m"
    anhCamXuc: {fileID: 2549212463485757873, guid: bd8a075b59f92e54786a355f57d1d53e, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "\xD4ng n\xF3i c\xE1i g\xEC?"
    anhCamXuc: {fileID: -5920170677128127979, guid: c7dd7826c7dd68247bd7aea3fa177303, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
