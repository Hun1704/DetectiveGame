  kichBanHoiThoai:
  - laNhanVatChinh: 0
    npcID: Quan
    noiDung: "B\u1EA3n quan nghe b\xE1o nh\xE0 n\xE0y c\xF3 tranh ch\u1EA5p. Tr\xE1nh
      ra \u0111\u1EC3 b\u1EA3n quan ki\u1EBFm tra hi\u1EC7n tr\u01B0\u1EDDng"
    anhCamXuc: {fileID: 3103107032202501148, guid: 70c37cf473a44a54fa052463133eb927, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
