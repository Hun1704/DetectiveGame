    bieuCam: {fileID: 0}
  - idNguoiNoi: 
    noiDung: "N\u1EB7ng qu\xE1... Sao g\xE1nh n\u1EB7ng cu\u1ED9c \u0111\u1EDDi cha
      l\u1EA1i \u0111\xE8 l\xEAn vai con th\u1EBF n\xE0y"
    bieuCam: {fileID: 0}
  - idNguoiNoi: 
    noiDung: "\u0110\u1EEBng nh\xECn con nh\u01B0 th\u1EBF... Cha t\u1EF1 l\xE0m
      m\xE0. Con ch\u1EC9 l\xE0 ng\u01B0\u1EDDi ch\u1EE9ng ki\u1EBFn th\xF4i."
    bieuCam: {fileID: 0}
  - idNguoiNoi: 
    noiDung: "Cha mu\u1ED1n ngh\u1EC9 ng\u01A1i m\xE0... Cha n\u1EE3 nhi\u1EC1u qu\xE1
      n\xEAn cha mu\u1ED1n \u0111i th\xF4i.."
    bieuCam: {fileID: 0}
