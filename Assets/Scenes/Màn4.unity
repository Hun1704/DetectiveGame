    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: thu
    noiDung: "Ng\u1EE7? Kh\xE1m nghi\u1EC7m t\u1EED thi cho th\u1EA5y T\xFA B\xE0
      tr\xFAng \u0111\u1ED9c Th\u1EA1ch T\xEDn. B\xE0 ta ch\u1EBFt ngay t\u1EA1i
      ch\u1ED7, m\u1EAFt m\u0169i tr\xE0o m\xE1u."
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    kichHoatNgatXiu_Lan1: 0
    kichHoatNgatXiu_Lan2: 0
