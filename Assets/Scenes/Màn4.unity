  - laNhanVatChinh: 1
    npcID: 
    noiDung: "Ng\u01B0\u01A1i n\xF3i b\u1EADy! Ta ch\u1EC9 chu\u1ED1c thu\u1ED1c
      m\xEA b\xE0 ta! B\xE0 ta ch\u1EC9 ng\u1EE7 th\xF4i!"
    anhCamXuc: {fileID: -7346555309823623052, guid: a940eb68aabb77443816f8dde4c2178e, type: 3}
    amThanhKem: {fileID: 0}
