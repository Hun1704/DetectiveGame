    danhSachHoiTuong: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: quan
    noiDung: "Ng\u01B0\u01A1i gi\u1EBFt ng\u01B0\u1EDDi c\u1EE7a ta, c\u01B0\u1EDBp
      ti\u1EC1n c\u1EE7a ta. Ta \u0111\xE3 cho ng\u01B0\u1EDDi t\xF3m g\u1ECDn ng\u01B0\u01A1i
      ngay khi ng\u01B0\u01A1i b\u01B0\u1EDBc ra kh\u1ECFi Ph\u1EE7 T\xE2m Hoa. Ng\u01B0\u01A1i
      kh\xF4ng h\u1EC1 t\u1EF1 nguy\u1EC7n \u0111\u1EBFn \u0111\xE2y ki\u1EC7n c\xE1o.
      Ng\u01B0\u01A1i b\u1ECB gi\u1EA3i \u0111\u1EBFn \u0111\xE2y nh\u01B0 m\u1ED9t
      t\xEAn t\u1EED t\xF9!"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    kichHoatTuBaXuatHien: 0
    kichHoatTuBaNgatXiu: 0
    kichHoatNgatXiu_Lan1: 0
    kichHoatNgatXiu_Lan2: 0
    kichHoatHoiTuong: 1
    danhSachHoiTuong:
    - hinhAnh: {fileID: 790210229967777426, guid: 4d4e3019a50b1f143af0f9e6c09c19a6, type: 3}
      noiDung: "Bao Thanh Long kh\xF4ng pha \"T\xE2m Sen\". Ng\u01B0\u1EDDi ch\u01A1i
        th\u1EA5y tay Bao Thanh Long c\u1EA7m l\u1ECD Th\u1EA1ch T\xEDn (nh\xE3n
        \"Th\u1EA1ch t\xEDn\") \u0111\u1ED5 d\u1ED1c v\xE0o \u1EA5m tr\xE0."
    - hinhAnh: {fileID: 790210229967777426, guid: 4d4e3019a50b1f143af0f9e6c09c19a6, type: 3}
      noiDung: "T\xFA B\xE0 u\u1ED1ng xong: B\xE0 ta kh\xF4ng g\u1EE5c xu\u1ED1ng
        ng\u1EE7 y\xEAn b\xECnh. B\xE0 ta co gi\u1EADt, c\xE0o c\u1EA5u v\xE0o c\u1ED5
        h\u1ECDng, phun m\xE1u v\xE0o m\u1EB7t Bao Thanh Long."
    - hinhAnh: {fileID: -8079615177721414338, guid: 8c454079f641a7243b12ca23207d9ede, type: 3}
      noiDung: "H\u1EAFn c\u01B0\u1EDDi h\u1EC1nh h\u1EC7ch, l\u1EE5c l\u1ECDi x\xE1c
        b\xE0 ta, l\u1EA5y ch\xECa kh\xF3a, l\u1EA5y ti\u1EC1n v\xE0ng nh\xE9t \u0111\u1EA7y
        t\xFAi (nh\u01B0ng hoang t\u01B0\u1EDFng ngh\u0129 \u0111\xF3 l\xE0 b\u1EB1ng
        ch\u1EE9ng)."
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    chuyenCanhSauCauNay: 0
    tenSceneChuyenToi: 
  - laNhanVatChinh: 0
    npcID: thu
    noiDung: "Bao Thanh Long. T\u1ED9i gi\u1EBFt cha m\u1EB9. T\u1ED9i gi\u1EBFt
