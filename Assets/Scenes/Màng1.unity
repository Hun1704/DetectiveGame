  loiRaQuan: {fileID: 1912030877}
  loiRaLinh: {fileID: 1865002183}
  kichBanHoiThoai:
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "Ch\u1EADc ch\u1EADc... \u0110\u01B0\u1EDDng \u0111\u01B0\u1EDDng l\xE0
      m\u1ED9t nh\xE0 nho, l\u1EA1i \u0111i vay n\u1EB7ng l\xE3i \u0111\u1EC3 r\u1ED3i
      t\xFAng qu\u1EABn l\xE0m li\u1EC1u. Ch\u1ED3ng gi\u1EBFt v\u1EE3, r\u1ED3i
      treo c\u1ED5 t\u1EF1 v\u1EABn. \u0110\xFAng l\xE0 bi k\u1ECBch."
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "\xD4ng n\xF3i b\u1EADy! Cha ta c\u1EA3 \u0111\u1EDDi thanh b\u1EA1ch,
      ch\u01B0a t\u1EEBng vay m\u01B0\u1EE3n ai n\u1EEDa xu. V\u1EBFt th\u01B0\u01A1ng
      tr\xEAn ng\u01B0\u1EDDi m\u1EB9 ta r\xF5 r\xE0ng l\xE0.."
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "L\xE0 do x\xF4 x\xE1t! H\u1EAFn gi\u1EBFt v\u1EE3 trong c\u01A1n \u0111i\xEAn
      lo\u1EA1n. C\xF2n \u0111\xE2y...\" (L\xFD H\xE0o n\xE9m to\u1EB9t m\u1ED9t
      t\u1EDD gi\u1EA5y xu\u1ED1ng \u0111\u1EA5t) \"Gi\u1EA5y n\u1EE3 vi\u1EBFt tay
      c\u1EE7a cha ng\u01B0\u01A1i, m\u1EF1c c\xF2n ch\u01B0a kh\xF4 \u0111\xE2u.
      \u0110\u1EEBng c\xF3 gi\xE0 m\u1ED3m"
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "\xD4ng n\xF3i c\xE1i g\xEC?"
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "Nh\xECn cho k\u1EF9 \u0111i. M\u1EB9 ng\u01B0\u01A1i b\u1ECB ch\xE9m
      t\u1EEB ph\xEDa sau, kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u kh\xE1ng c\u1EF1. Trong
      nh\xE0 \u0111\u1ED3 \u0111\u1EA1c kh\xF4ng m\u1EA5t m\xE1t th\u1EE9 g\xEC.
      \u0110\xE2y kh\xF4ng ph\u1EA3i c\u01B0\u1EDBp."
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "V\u1EADy th\xEC c\xE0ng ph\u1EA3i \u0111i\u1EC1u tra..."
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "C\u1EA7n g\xEC \u0111i\u1EC1u tra! Ta \u0111\xE3 nghe phong thanh t\u1EEB
      l\xE2u, cha ng\u01B0\u01A1i \u2013 c\xE1i l\xE3o gi\xE0 nho nh\xE3 n\xE0y \u2013
      th\u1EF1c ch\u1EA5t n\u1EE3 n\u1EA7n ng\u1EADp \u0111\u1EA7u, l\u1EA1i c\xF2n
      d\xEDnh l\xEDu \u0111\u1EBFn v\u1EE5 bi\u1EC3n th\u1EE7 c\xF4ng qu\u1EF9 \u1EDF
      kho th\xF3c huy\u1EC7n. "
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "Ch\u1EAFc l\xE0 b\u1ECB m\u1EB9 ng\u01B0\u01A1i ph\xE1t hi\u1EC7n,
      hai b\xEAn x\xF4 x\xE1t. L\xE3o ta c\xF9ng \u0111\u01B0\u1EDDng sinh qu\u1EABn,
      ra tay s\xE1t h\u1EA1i v\u1EE3 r\u1ED3i treo c\u1ED5 t\u1EF1 v\u1EABn \u0111\u1EC3
      tr\u1ED1n t\u1ED9i!"
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "Ng\u1EADm m\xE1u phun ng\u01B0\u1EDDi! Cha ta c\u1EA3 \u0111\u1EDDi
      thanh b\u1EA1ch, \u0111\u1EBFn h\u1EA1t g\u1EA1o c\u1EE7a d\xE2n c\u0169ng
      kh\xF4ng d\xE1m nh\u1EADn sai! L\xE0m sao c\xF3 chuy\u1EC7n tham \xF4? "
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "V\u1EBFt ch\xE9m tr\xEAn l\u01B0ng m\u1EB9 ta s\u1EAFc ng\u1ECDt nh\u01B0
      th\u1EBF, cha ta l\xE0 th\u01B0 sinh tr\xF3i g\xE0 kh\xF4ng ch\u1EB7t, l\xE0m
      sao ch\xE9m \u0111\u01B0\u1EE3c?"
    cacLuaChon: []
  - nguoiNoi: 2
    anhBieuCam: {fileID: 0}
    noiDung: "Im ngay! c\xE1i th\u1EE9 quan kh\u1ED1 r\xE1ch \xE1o \xF4m nh\u01B0
      ng\u01B0\u01A1i d\xE1m h\u1ED7n x\u01B0\u1EE3c v\u1EDBi quan ph\u1EE7?"
    cacLuaChon: []
  - nguoiNoi: 2
    anhBieuCam: {fileID: 0}
    noiDung: "C\xF3 tin t cho c\u1EA3 nh\xE0 ng\u01B0\u01A1i ch\u1EBFt kh\xF4ng ch\u1ED7
      ch\xF4n kh\xF4ng?"
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "Cha m\u1EB9 ta ch\u1EBFt kh\xF4ng nh\u1EAFm m\u1EAFt ngay \u0111\xE2y
      \u0111\xE2y, ng\u01B0\u01A1i c\xF3 gan \u0111\xF3? "
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "V\u1EADy \xFD ng\u01B0\u01A1i l\xE0 ta sai? Ng\u01B0\u01A1i \u2013
      m\u1ED9t t\xEAn quan t\xE9p riu, \u0111ang d\u1EA1y ta c\xE1ch ph\xE1 \xE1n
      sao? Ch\u1EE9ng c\u1EE9 r\xE0nh r\xE0nh: Kh\xF4ng c\xF3 ng\u01B0\u1EDDi ngo\xE0i
      \u0111\u1ED9t nh\u1EADp, ch\u1EC9 c\xF3 hai x\xE1c ch\u1EBFt v\xE0 m\u1ED9t
      m\xF3n n\u1EE3 kh\u1ED5ng l\u1ED3 m\xE0 l\xE3o ta \u0111\u1EC3 l\u1EA1i "
    cacLuaChon:
    - noiDungNut: "C\u1EA7u xin"
      mcTraLoi: "Th\u01B0a quan, cha m\u1EB9 t\xF4i s\u1ED1ng v\u1EDBi nhau c\u1EA3
        \u0111\u1EDDi h\xF2a thu\u1EADn, ch\u01B0a t\u1EEBng to ti\u1EBFng. Xin quan
        xem x\xE9t l\u1EA1i t\xECnh l\xFD!"
      npcDapLai: "T\xECnh l\xFD? Ng\u01B0\u01A1i l\xE0m quan m\xE0 ng\xE2y th\u01A1
        th\u1EBF sao? H\u1ECDa h\u1ED5 h\u1ECDa b\xEC nan h\u1ECDa c\u1ED1t. Tr\u01B0\u1EDBc
        m\u1EB7t ng\u01B0\u01A1i th\xEC h\xF2a thu\u1EADn, sau l\u01B0ng th\xEC n\u1EE3
        n\u1EA7n ch\u1ED3ng ch\u1EA5t, t\xFAng qu\u1EABn l\xE0m li\u1EC1u. \u0110\xF3
        l\xE0 l\u1EBD th\u01B0\u1EDDng!\""
    - noiDungNut: "L\xFD l\u1EBD"
      mcTraLoi: "V\u1EBFt ch\xE9m tr\xEAn l\u01B0ng m\u1EB9 r\u1EA5t ng\u1ECDt, l\u1EA1i
        t\u1EEB ph\xEDa sau. Cha con l\xE0 th\u01B0 sinh tr\xF3i g\xE0 kh\xF4ng ch\u1EB7t,
        trong nh\xE0 l\u1EA1i ch\u1EC9 c\xF3 dao th\xE1i rau c\xF9n, l\xE0m sao g\xE2y
        ra v\u1EBFt th\u01B0\u01A1ng \u0111\xF3"
      npcDapLai: "L\xFAc \u0111i\xEAn l\xEAn th\xEC s\u1EE9c tr\xE2u c\u0169ng c\xF3.
        H\u1EAFn m\xE0i dao hay mua dao m\u1EDBi ta l\xE0m sao bi\u1EBFt? Ng\u01B0\u01A1i
        \u0111ang c\u1ED1 bi\u1EC7n h\u1ED9 cho k\u1EBB t\u1ED9i \u0111\u1ED3 \u0111\u1EA5y
        \xE0?"
    - noiDungNut: "gay g\u1EAFt"
      mcTraLoi: "V\u1EE5 \xE1n ch\u01B0a kh\xE1m nghi\u1EC7m k\u1EF9 c\xE0ng m\xE0
        quan \u0111\xE3 v\u1ED9i k\u1EBFt lu\u1EADn. Ph\u1EA3i ch\u0103ng ng\xE0i
        \u0111ang mu\u1ED1n che gi\u1EA5u \u0111i\u1EC1u g\xEC"
      npcDapLai: "To gan! Ng\u01B0\u01A1i d\xE1m vu kh\u1ED1ng m\u1EC7nh quan tri\u1EC1u
        \u0111\xECnh? N\u1EBFu kh\xF4ng n\u1EC3 t\xECnh ng\u01B0\u01A1i c\u0169ng
        mang \u0111ai \xE1o quan, ta \u0111\xE3 cho ng\u01B0\u01A1i \u0103n \u0111\xF2n
        roi n\xE1t th\u1ECBt r\u1ED3i"
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "V\u1EE5 \xE1n \u0111\xE3 r\xF5. Hung th\u1EE7 l\xE0 ch\u1ED3ng gi\u1EBFt
      v\u1EE3, sau \u0111\xF3 t\u1EF1 s\xE1t v\xEC s\u1EE3 t\u1ED9i. Lo\u1EA1i t\u1ED9i
      ph\u1EA1m, l\u1EA1i c\xF2n m\u1EAFc n\u1EE3 c\xF4ng nh\u01B0 th\u1EBF n\xE0y
      kh\xF4ng x\u1EE9ng \u0111\xE1ng \u0111\u01B0\u1EE3c ch\xF4n c\u1EA5t t\u1EED
      t\u1EBF"
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "C\xE1c ng\u01B0\u1EDDi \u0111\u1ECBnh l\xE0m g\xEC?"
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "T\u1ECBch thu to\xE0n b\u1ED9 t\xE0i s\u1EA3n trong nh\xE0 \u0111\u1EC3
      tr\u1EEB n\u1EE3! C\xF2n hai c\xE1i x\xE1c n\xE0y... (nh\u1EBFch m\xE9p) mang
      ra b\xE3i tha ma ph\xEDa sau n\xFAi, qu\u0103ng xu\u1ED1ng h\u1ED1 ch\xF4n
      t\u1EADp th\u1EC3. \u0110\u1EEBng \u0111\u1EC3 l\xE0m \xF4 u\u1EBF \u0111\u1EA5t
      l\xE0ng V\xE2n L\u1EC7."
    cacLuaChon: []
  - nguoiNoi: 0
    anhBieuCam: {fileID: 0}
    noiDung: "K\u1EBB n\xE0o d\xE1m \u0111\u1ED9ng v\xE0o cha m\u1EB9 ta, ta li\u1EC1u
      m\u1EA1ng v\u1EDBi k\u1EBB \u0111\xF3!"
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "\xC1 \xE0, mu\u1ED1n ch\u1ED1ng ng\u01B0\u1EDDi thi h\xE0nh c\xF4ng
      v\u1EE5? Bao Thanh Long, ta nghi ng\u1EDD ng\u01B0\u01A1i c\u0169ng c\xF3 li\xEAn
      quan \u0111\u1EBFn v\u1EE5 tham \xF4 n\xE0y c\u1EE7a cha ng\u01B0\u01A1i."
    cacLuaChon: []
  - nguoiNoi: 1
    anhBieuCam: {fileID: 0}
    noiDung: "T\u1ED1t nh\u1EA5t l\xE0 ngoan ngo\xE3n, ta c\xF2n n\u1EC3 t\xECnh
      \u0111\u1ED3ng nghi\u1EC7p m\xE0 cho ng\u01B0\u01A1i t\u1EA1i ngo\u1EA1i \u0111i\u1EC1u
      tra. N\u1EBFu c\xF2n ngoan c\u1ED1, ta g\xF4 c\u1ED5 ng\u01B0\u01A1i v\xE0o
      ng\u1EE5c ngay l\u1EADp t\u1EE9c! Ng\u01B0\u1EDDi \u0111\xE2u, d\u1ECDn d\u1EB9p!"
    cacLuaChon: []
  loiTuThoaiKetThuc:
  - "T\u1EF1 s\xE1t \u01B0? N\u1EE3 n\u1EA7n \u01B0? ... L\xFD H\xE0o, \xF4ng t\u01B0\u1EDFng
    ta m\xF9 sao?"
  danhSachVatChung:
  - {fileID: 1033210435}
  - {fileID: 684560797}
  - {fileID: 1170738617}
