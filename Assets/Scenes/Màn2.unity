  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CutsceneManager
  sfxAudioSource: {fileID: 0}
  tiengGioCua: {fileID: 0}
  fadePanel: {fileID: 0}
  timeText: {fileID: 0}
  choiceContainer: {fileID: 0}
  choiceButtonPrefab: {fileID: 8012488246747917166, guid: c9ae964d643169645a4e1ae579b97f33, type: 3}
  quan: {fileID: 0}
  linh: {fileID: 0}
  tocDoDiChuyen: 0
  viTriDungQuan: {fileID: 0}
  viTriDungLinh: {fileID: 0}
  loiRaQuan: {fileID: 0}
  loiRaLinh: {fileID: 0}
  kichBanHoiThoai:
  - laNhanVatChinh: 0
    npcID: TuBa
    noiDung: "\xD4 k\xECa c\xF4ng t\u1EED... L\xE2u l\u1EAFm m\u1EDBi th\u1EA5y gh\xE9
      ch\u01A1i. Nh\u01B0ng quy t\u1EAFc \u1EDF \u0111\xE2y ng\xE0i bi\u1EBFt r\u1ED3i
      \u0111\u1EA5y, mu\u1ED1n b\u01B0\u1EDBc qua c\u1EEDa n\xE0y th\xEC ph\u1EA3i
      'n\u1EB7ng t\xFAi' m\u1ED9t ch\xFAt"
    anhCamXuc: {fileID: -2750568329095551366, guid: ef1a38c7795ae3c489512a354a2724cb, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "H\u1EEB, m\u1EE5 gi\xE0 l\xF3a m\u1EAFt. B\xE0 nh\xECn b\u1ED9 d\u1EA1ng
      ta gi\u1ED1ng k\u1EBB thi\u1EBFu th\u1ED1n sao? C\u1EA7m l\u1EA5y!\""
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  - laNhanVatChinh: 0
    npcID: TuBa
    noiDung: "Ch\xE0... \u0110\u1ED3 t\u1ED1t, \u0111\u1ED3 t\u1ED1t! M\u1EDDi kh\xE1ch
      quan v\xE0o, t\xF4i \u0111\xFAng l\xE0 c\xF3 m\u1EAFt nh\u01B0 m\xF9"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "B\u1EDBt l\u1EDDi \u0111i. Ta h\u1ECFi b\xE0, t\xEAn quan tham L\xFD
      H\xE0o c\xF3 th\u01B0\u1EDDng xuy\xEAn lui t\u1EDBi c\xE1i \u1ED5 n\xE0y kh\xF4ng"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  - laNhanVatChinh: 0
    npcID: TuBa
    noiDung: "Quan L\xFD H\xE0o \u1EA5y \xE0? Ng\xE0i \u1EA5y l\xE0 kh\xE1ch VIP...
      \xE0 kh\xF4ng, l\xE0 'b\u1EB1ng h\u1EEFu' th\xE2n thi\u1EBFt c\u1EE7a n\u01A1i
      n\xE0y. Ng\xE0i t\xECm ng\xE0i \u1EA5y c\xF3 vi\u1EC7c g\xEC?\""
    anhCamXuc: {fileID: 2311720398008586407, guid: 300434e3a19017e4eab0d45294420e1a, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "B\xE0 Ch\u1EE7... \u0110\u1EEBng l\xE0m kh\xF3 ng\xE0i \u1EA5y. \u0110\u1EC3
      h\u1EAFn l\xEAn \u0111\xE2y, t\xF4i c\xF3 chuy\u1EC7n c\u1EA7n 't\xEDnh to\xE1n'
      v\u1EDBi c\u1ED1 nh\xE2n.\""
    anhCamXuc: {fileID: 4008839630249481237, guid: f59577e8c90ec2a45b1fa15c1157523b, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "Ng\u1ECDc Khu\xEA? N\xE0ng ta v\u1EABn \u1EDF \u0111\xE2y sao? Ch\u1EAFc
      h\u1EB3n n\xE0ng \u0111ang n\u1EAFm gi\u1EEF b\xED m\u1EADt g\xEC \u0111\xF3
      n\xEAn m\u1EDBi g\u1ECDi ta."
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
  loiTuThoaiKetThuc: []
  danhSachVatChung: []
