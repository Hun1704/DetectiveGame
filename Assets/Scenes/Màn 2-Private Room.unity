--- !u!114 &675150587
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 675150584}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c12a6832ecb6d0a4cb19c36fca6b3b17, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TuBaSearch
  idVatPham: 6
  nutLucSoat: {fileID: 644514572}
  bangKetThuc: {fileID: 1399405844}
  danhSachLoiThoai:
  - characterID: 
    noiDung: "Ti\u1EBFp theo th\xEC nh\u01B0 th\u1EBF n\xE0o"
    bieuCam: {fileID: 0}
  - characterID: NgocKhue
    noiDung: "Sao ph\u1EA3i v\u1ED9i v\xE0ng, chuy\u1EC7n ch\xFAng ta c\xF2n ch\u01B0a
      t\u1ECF? ch\xE0ng g\u1EA5p g\xE1p nh\u01B0 v\u1EADy \u0111\u1EC3 l\xE0m g\xEC"
    bieuCam: {fileID: 0}
  - characterID: 
    noiDung: "Thanh minh cho cha ta, \u0111\u01B0\u01A1ng nhi\xEAn g\u1EA5p"
    bieuCam: {fileID: 0}
  - characterID: NgocKhue
    noiDung: "\u0110\xE2y ch\xEDnh l\xE0 s\u1ED5 s\xE1ch c\u1EE7a Ph\u1EE7 T\xE2m
      Hoa nh\u1EEFng th\xE1ng qua, c\xF3 ph\u1EA7n ghi ch\xE9p c\u1EE7a L\xFD H\xE0o"
    bieuCam: {fileID: 0}
  - characterID: 
    noiDung: "Nh\xECn xem, ng\xE0y n\xE0y th\xE1ng n\xE0y, h\u1EAFn nh\u1EADn 500
      l\u01B0\u1EE3ng. Ch\u1EB3ng tr\xE1ch h\u1EAFn gi\xE0u c\xF3 nh\u01B0 v\u1EADy
      trong khi d\xE2n ch\xFAng l\u1EA7m than. \nV\u1EDBi b\u1EB1ng ch\u1EE9ng n\xE0y,
      \u0110\u1EA1i Quan \u1EDF Kinh \u0110\xF4 ch\u1EAFc ch\u1EAFn s\u1EBD ch\xE9m
      \u0111\u1EA7u h\u1EAFn. "
    bieuCam: {fileID: 0}
  - characterID: 
    noiDung: "V\xE2y..."
    bieuCam: {fileID: 0}
  - characterID: 
    noiDung: "\u0110\u01B0\u1EE3c r\u1ED3i, ta c\xF2n vi\u1EC7c ph\u1EA3i \u0111i"
    bieuCam: {fileID: 0}
