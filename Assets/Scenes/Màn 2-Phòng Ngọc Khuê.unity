    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "L\xE0m sao c\xF4 t\u01B0\u1EDDng t\u1EADn nh\u01B0 th\u1EBF? Ch\u1EB3ng
      l\u1EBD c\xF4 c\u0169ng c\u0103m h\u1EADn h\u1EAFn"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "C\xF3 th\u1EC3 coi t\xF4i l\xE0 ng\u01B0\u1EDDi c\xF3 'giao t\xECnh'
      s\xE2u \u0111\u1EADm v\u1EDBi ph\u1EE5 m\u1EABu c\u1EADu. Ta \u0111\xE3 th\u1EA5y...
      h\u1ECD kh\u1ED5 s\u1EDF th\u1EBF n\xE0o v\xEC nh\u1EEFng t\u1EDD gi\u1EA5y
      n\xE0y"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "L\xFD H\xE0o... t\xEAn c\u1EA9u quan! H\u1EAFn d\xE1m d\xF9ng gi\u1EA5y
      t\u1EDD gi\u1EA3 \u0111\u1EC3 vu kh\u1ED1ng cha ta tham \xF4!. Ph\u1EA3i ch\u0103ng
      ch\xEDnh h\u1EAFn l\xE0 ng\u01B0\u1EDDi tham \xF4 l\u1EA1i \u0111\u1ED5 cho
      cha ta"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "Gi\u1EA3 hay th\u1EADt, c\u1EADu t\u1EF1 tra s\u1EBD r\xF5. "
    anhCamXuc: {fileID: -4079534012856668657, guid: 2fd2ebd3a9582bd40a7d92d1649874e3, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "Ta bi\u1EBFt h\u1EAFn ch\xEDnh l\xE0 k\u1EBB n\u1EA5p \u0111\u1EB1ng
      sau c\u1EE7a Ph\u1EE7 T\xE2m Hoa n\xE0y, nh\u01B0ng ta kh\xF4ng c\xF3 c\xE1ch
      \u0111\u1EC3 l\u1EA5y \u0111\u01B0\u1EE3c s\u1ED5 s\xE1ch c\u1EE7a n\u01A1i
      \u0111\xE2y"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "(R\xFAt ra m\u1ED9t cu\u1ED1n s\u1ED5 d\xE0y) \"T\u1EA5t c\u1EA3 t\u1ED9i
      \xE1c c\u1EE7a L\xFD H\xE0o v\xE0 m\u1EE5 T\xFA B\xE0 \u0111\u1EC1u n\u1EB1m
      trong cu\u1ED1n 'S\u1ED5 \u0110en' n\xE0y. Nh\u01B0ng..."
    anhCamXuc: {fileID: 1952134013425826388, guid: b8250af6ec539574191264cd4557180f, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "Nh\u01B0ng sao? \u0110\u01B0a n\xF3 cho ta! Ta s\u1EBD v\u1EA1ch tr\u1EA7n
      b\u1ECDn ch\xFAng!"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "Ta ch\u1EC9 n\u1EAFm gi\u1EEF b\u1EA3n sao th\xF4i. B\u1EA3n g\u1ED1c
      c\xF3 con d\u1EA5u quan tri\u1EC1u \u0111\xECnh... \u0111ang n\u1EB1m trong
      tay m\u1EE5 T\xFA B\xE0. M\u1EE5 ta \u0111eo ch\xECa kh\xF3a b\xEAn ng\u01B0\u1EDDi,
      kh\xF4ng r\u1EDDi n\u1EEDa b\u01B0\u1EDBc"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 1
    npcID: 
    noiDung: "T\xFA B\xE0? M\u1EE5 gi\xE0 x\u1EA3o quy\u1EC7t \u0111\xF3 sao? Ta
      s\u1EBD xu\u1ED1ng \u0111\xF3 \xE9p m\u1EE5 giao ra!"
    anhCamXuc: {fileID: -3569619843996905790, guid: e2dce61840e476246934b3af6928ef86, type: 3}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "\u0110\u1EEBng n\xF3ng v\u1ED9i. M\u1EE5 ta c\xF3 l\xEDnh canh. H\xE3y
      d\xF9ng tr\xED. M\u1EE5 ta r\u1EA5t nghi\u1EC7n tr\xE0 'T\xE2m Sen' \u0111\u1EC3
      ch\u1EEFa ch\u1EE9ng \u0111au \u0111\u1EA7u kinh ni\xEAn."
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  - laNhanVatChinh: 0
    npcID: NgocKhue
    noiDung: "Theo ta qua \u0111\xE2y"
    anhCamXuc: {fileID: 0}
    amThanhKem: {fileID: 0}
    cacLuaChon: []
    idVatPhamYeuCau: 0
    cauThoaiSauKhiNhan: 
    kichHoatTuBaXuatHien: 0
  loiTuThoaiKetThuc: []
  danhSachVatChung: []
  thongBaoPanel: {fileID: 0}
  noiDungThongBao: {fileID: 0}
